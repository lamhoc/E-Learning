# SQL Server 2019 + TypeORM
DB_HOST=127.0.0.1
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=your_sql_server_password
DB_NAME=AutoBankELearning
DB_ENCRYPT=false
DB_TRUST_CERT=true
DB_LOGGING=false

# JWT Session Secret (tối thiểu 32 ký tự ngẫu nhiên)
JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_chars

SITE_URL=http://localhost:3000
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Email Service (Lựa chọn 1: Gmail SMTP gửi không giới hạn mọi email; Lựa chọn 2: Resend API)
SMTP_USER=
SMTP_PASS=

# Resend Email Service (Nếu dùng Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Đại học Lạc Hồng <onboarding@resend.dev>

# Cloudflare Named Tunnel (Tùy chọn — để trống sẽ tự dùng Quick Tunnel miễn phí)
CLOUDFLARE_TUNNEL_TOKEN=
